# 视频转码管理系统配置示例
#
# 将此文件复制为 .env 并修改为自己的实际路径
# cp .env.example .env

# ================
# 路径配置
# ================

# 宿主机的输入目录（视频文件所在目录）
# 请修改为实际的绝对路径
INPUT_DIR=/home/user/videos

# 宿主机的输出目录（转码后的文件保存目录）
# 请修改为实际的绝对路径
OUTPUT_DIR=/home/user/output

# ================
# 任务和性能
# ================

# 最大并发转码任务数
# 根据机器性能调整，建议设置为CPU核心数的50%
# AV1 软件编码非常消耗CPU，建议从2开始测试
MAX_CONCURRENCY=2

# Docker Host（如果使用远程Docker，取消下面注释并配置）
# DOCKER_HOST=tcp://remote-docker-host:2375

# ================
# 视频编码配置
# ================

# 编码器类型（重要！）
# - software: 软件编码（纯CPU，兼容性好但速度慢）
# - nvenc: NVIDIA 硬件编码（需要NVIDIA GPU）
# - qsv: Intel QSV 硬件编码（需要Intel GPU）
# - amf: AMD AMF 硬件编码（需要AMD GPU）
ENCODER_TYPE=software

# 视频编码格式
# - h264: H.264/AVC（兼容性最好，所有设备支持）
# - hevc: H.265/HEVC（文件更小，主流设备支持）
# - av1: AV1（最新格式，文件最小，部分设备支持）
VIDEO_CODEC=av1

# 软件编码的预设值（仅 ENCODER_TYPE=software 时有效）
# SVT-AV1: 0-12（0=最快质量最低, 12=最慢质量最高，推荐6-8）
SOFTWARE_PRESET=6

# 硬件编码的预设值（仅 ENCODER_TYPE=nvenc/qsv/amf 时有效）
# NVIDIA NVENC: p1-p7（p1=最快, p7=质量最高，推荐p4-p6）
# Intel QSV: veryfast, faster, fast, medium, slow, slower, veryslow（推荐medium）
# AMD AMF: speed, balanced, quality（推荐balanced）
HARDWARE_PRESET=medium

# CRF 质量因子（可选）
# H.264: 0-51（默认23，推荐20-28）
# H.265: 0-51（默认28，推荐25-32）
# AV1: 0-63（默认35，推荐30-40）
# 值越小质量越高文件越大，不设置则使用编码器默认值
# CRF=35

# ================
# 音频配置
# ================

# 音频编码器
# libopus: Opus（推荐，质量好）
# aac: AAC（兼容性最好）
# libmp3lame: MP3
AUDIO_CODEC=libopus

# 音频码率
AUDIO_BITRATE=128k
